<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ChatApp.Client.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ChatApp.Client.ViewModels"
    xmlns:behaviors="clr-namespace:ChatApp.Client.Behaviors"
    x:DataType="vm:RegisterViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">

            <Label Text="Create your account" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,16" />

            <Entry Placeholder="Display name" Text="{Binding DisplayName.Value}" ReturnType="Next">
                <Entry.Triggers>
                    <DataTrigger TargetType="Entry" Binding="{Binding DisplayName.IsValid}" Value="False">
                        <Setter Property="BackgroundColor" Value="#FFEBEE" />
                    </DataTrigger>
                </Entry.Triggers>
            </Entry>
            <Label Text="{Binding DisplayName.Error}" TextColor="Red" FontSize="12"
                   IsVisible="{Binding DisplayName.IsValid, Converter={StaticResource InvertedBoolConverter}}" />

            <Entry Placeholder="Username" Text="{Binding Username.Value}" ReturnType="Next">
                <Entry.Triggers>
                    <DataTrigger TargetType="Entry" Binding="{Binding Username.IsValid}" Value="False">
                        <Setter Property="BackgroundColor" Value="#FFEBEE" />
                    </DataTrigger>
                </Entry.Triggers>
            </Entry>
            <Label Text="{Binding Username.Error}" TextColor="Red" FontSize="12"
                   IsVisible="{Binding Username.IsValid, Converter={StaticResource InvertedBoolConverter}}" />

            <Entry Placeholder="Password" Text="{Binding Password.Value}" IsPassword="True" ReturnType="Done">
                <Entry.Triggers>
                    <DataTrigger TargetType="Entry" Binding="{Binding Password.IsValid}" Value="False">
                        <Setter Property="BackgroundColor" Value="#FFEBEE" />
                    </DataTrigger>
                </Entry.Triggers>
            </Entry>
            <Label Text="{Binding Password.Error}" TextColor="Red" FontSize="12"
                   IsVisible="{Binding Password.IsValid, Converter={StaticResource InvertedBoolConverter}}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Sign Up" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Already have an account? Log in" BackgroundColor="Transparent" TextColor="{StaticResource Primary}">
                <Button.Behaviors>
                    <behaviors:NavigateBehavior Route=".." />
                </Button.Behaviors>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
