<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ChatApp.Client.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ChatApp.Client.ViewModels"
    xmlns:models="clr-namespace:ChatApp.Client.Models"
    x:DataType="vm:ChatViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">

        <CollectionView Grid.Row="0" ItemsSource="{Binding Messages}" VerticalOptions="Fill">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MessageModel">
                    <ContentView Padding="12,4">
                        <Border Padding="12,8"
                                MaximumWidthRequest="280"
                                HorizontalOptions="End"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{StaticResource Primary}"
                                x:Name="Bubble">
                            <VerticalStackLayout>
                                <Label Text="{Binding SenderDisplayName}" TextColor="{StaticResource Secondary}" FontSize="11" FontAttributes="Bold" />
                                <Label Text="{Binding Text}" TextColor="White" />
                                <Label Text="{Binding SentAt, StringFormat='{0:t}'}" TextColor="{StaticResource Secondary}" FontSize="10" HorizontalOptions="End" />
                            </VerticalStackLayout>

                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="False">
                                    <Setter Property="HorizontalOptions" Value="Start" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource Gray400}" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />

        <Grid Grid.Row="1" Padding="8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Placeholder="Type a message" Text="{Binding MessageText}" ReturnCommand="{Binding SendCommand}" />
            <Button Grid.Column="1" Text="Send" Command="{Binding SendCommand}" />
        </Grid>
    </Grid>
</ContentPage>
