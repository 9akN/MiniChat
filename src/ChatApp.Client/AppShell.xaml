<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ChatApp.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ChatApp.Client.Views"
    FlyoutBehavior="Disabled"
    Title="MiniChat">

    <ShellContent
        Title="Login"
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar>
        <ShellContent
            Title="Chats"
            Route="ChatsPage"
            ContentTemplate="{DataTemplate views:ChatsPage}" />

        <ShellContent
            Title="Contacts"
            Route="ContactsPage"
            ContentTemplate="{DataTemplate views:ContactsPage}" />

        <ShellContent
            Title="Settings"
            Route="SettingsPage"
            ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

</Shell>
